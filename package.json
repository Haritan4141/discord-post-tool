{
  "name": "discord-post-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Create Discord channels from folders and upload paired zip/pdf files.",
  "main": "src/gui/main.js",
  "bin": {
    "discord-post-tool": "src/cli.js"
  },
  "scripts": {
    "app": "node src/gui/launch.js",
    "app:smoke": "node src/gui/launch.js --smoke-test",
    "test": "node --test",
    "plan": "node src/cli.js plan",
    "run": "node src/cli.js run",
    "build-assets": "node src/build-assets.js",
    "check": "node src/cli.js plan --input ./example"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.5",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^41.5.2"
  }
}
